# Copia esto a .env y pon tu propio token:
#
#     cp env.example .env
#
# .env esta en .gitignore a proposito. Una vez se colo en un commit, acabo en
# un repo publico y hubo que rotar el token; no vuelvas a forzar su subida.

# Token que exigen /tts, /stt y /tts/stream. Si lo dejas VACIO la API queda
# ABIERTA a cualquiera que alcance el puerto: solo hazlo en una maquina
# aislada. Generar uno:
#
#     openssl rand -hex 24
#
VOZ_TOKEN=

# Solo para el perfil "gpu". Indice de la rueda de torch con CUDA que
# sustituye a la de CPU. cu130 esta comprobado que sirve torch 2.13.0, la
# MISMA version que fija el lock, asi que cambia el backend y no la version.
# cu128 solo llega a 2.11 y obligaria a bajar de version todo lo demas.
TORCH_CUDA=cu130
