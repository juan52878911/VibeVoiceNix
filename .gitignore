# Nix
result
result-*
.direnv/

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Ansible
*.retry
ansible/inventory/hosts.generated.yml

# Secretos: el token de la API y las credenciales de Proxmox nunca entran al repo
secrets/
*.age
*.key
# .env lleva VOZ_TOKEN. Se colo en un commit y acabo en un repo PUBLICO; el
# token hubo que rotarlo. Que no vuelva a pasar.
.env
*.env
!*.env.example

# Modelos y artefactos de build: son DERIVADOS, se regeneran con un comando.
# El de whisper son 465 MB y GitHub rechaza cualquier fichero de mas de 100.
docker/modelos/
*.tar.gz
*.safetensors
*.gguf
*.ggml

# Python
__pycache__/
*.py[cod]
.venv/

# Audio de pruebas
*.wav
*.ogg
*.mp3
!pkgs/voz-api/tests/fixtures/*.wav

# macOS
.DS_Store
graphify-out/

# Perfiles de voz del asistente (huellas de locutor; datos locales)
perfiles_voz.json

# Metadatos AppleDouble que macOS deja al escribir en volumenes no-APFS.
# Son basura: 42.000 de estos dentro de un venv rompen `import transformers`.
._*
.DS_Store
